# Security Settings
# Generate a secure key for production (e.g. using `python -c "import secrets; print(secrets.token_urlsafe(50))"`)
SECRET_KEY=django-insecure-%mpzac0)ea@!j0bqh6@t5kwgjq%)z3m^r91qmh=ww!f9q4cgnx

# Set to False in Production!
DEBUG=True

# Comma-separated list of allowed domains/IPs
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com,.railway.app,.herokuapp.com

# Comma-separated list of trusted CSRF origins for HTTPS production domains
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://*.onrender.com,https://*.railway.app

# ==============================================================================
# Cloud Production Database Connection (PostgreSQL / Neon / Supabase / AWS RDS / MySQL)
# ==============================================================================
# Leave blank to use local SQLite (db.sqlite3) during development.
# For Cloud Production, set your PostgreSQL connection string:
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
# Examples:
# Neon Postgres:     postgres://neondb_owner:npg_xyz@ep-cold-pond-a5...neon.tech/neondb?sslmode=require
# Supabase Postgres: postgres://postgres.yourproject:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# Render Postgres:   postgres://desicine_user:xyz@dpg-xyz.oregon-postgres.render.com/desicine_db
# Railway Postgres:  postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway
